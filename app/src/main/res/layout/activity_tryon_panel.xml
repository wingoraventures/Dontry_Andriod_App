<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#44000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="32dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_drag_handle"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- Top row: label + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VIRTUAL TRY-ON"
                android:textColor="#2E9E8A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"/>

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_input"/>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See how this looks on you"
            android:textColor="#1a1a1a"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select photo to try on"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#eeeeee"
            android:layout_marginBottom="16dp"/>

        <!-- SELECT PHOTO LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT YOUR PHOTO"
            android:textColor="#888888"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="10dp"/>

        <!-- Swipeable Photos Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/llPhotosRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Original Photo (always shown) -->
                <LinearLayout
                    android:id="@+id/llOriginalPhoto"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">

                    <!-- Photo frame -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:id="@+id/ivOriginalPhoto"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:outlineProvider="background"/>

                        <!-- Selected indicator -->
                        <View
                            android:id="@+id/vOriginalSelected"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_selected_border"
                            android:visibility="visible"/>

                        <!-- Tick when selected -->
                        <TextView
                            android:id="@+id/tvOriginalTick"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:text="✓"
                            android:textColor="#ffffff"
                            android:textSize="9sp"
                            android:gravity="center"
                            android:background="@drawable/bg_tick_green"
                            android:layout_gravity="bottom|end"
                            android:visibility="visible"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original"
                        android:textColor="#1a1a1a"
                        android:textSize="9sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Saved Looks Container (added dynamically) -->
                <LinearLayout
                    android:id="@+id/llSavedLooks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Selected label -->
        <TextView
            android:id="@+id/tvSelectedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Using: Original photo"
            android:textColor="#2E9E8A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#eeeeee"
            android:layout_marginBottom="16dp"/>

        <!-- Garment + Arrow + Photo row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Captured garment box -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GARMENT"
                    android:textColor="#2E9E8A"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Captured from screen"
                    android:textColor="#bbbbbb"
                    android:textSize="10sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#E8622A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <!-- Selected user photo preview -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/ivUserPhoto"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvUserPhotoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your photo"
                    android:textColor="#bbbbbb"
                    android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Generate button -->
        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Generate Try-On"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:background="@drawable/bg_teal_btn"/>

    </LinearLayout>
</FrameLayout>